{
  "_meta": {
    "version": "3.0",
    "note": "OOBE 职场测评。设计依据见 设计决策.md「测评生成」。",
    "principle": "挑痛苦，不答题。人对偏好会美化自己，对痛苦很诚实——信号质量更高，且挑卡过程本身就是第一次『被说中』。",
    "hardConstraint": "五个轴的两端必须对称赋值，不存在负极。任何一端被写成缺点，整套『不攻击、只合理化』就崩了。"
  },
  "axes": {
    "tempo": {
      "name": "推进节奏",
      "pos": "先动起来",
      "neg": "想清楚再动",
      "posGood": "响应快",
      "negGood": "一次做对"
    },
    "energy": {
      "name": "消耗方式",
      "pos": "人多了才有劲",
      "neg": "人多了就没电",
      "posGood": "接得住",
      "negGood": "沉得下"
    },
    "basis": {
      "name": "做事依据",
      "pos": "先有框架",
      "neg": "先有感觉",
      "posGood": "靠谱",
      "negGood": "有想法"
    },
    "resilience": {
      "name": "挨批之后",
      "pos": "过一会就过去了",
      "neg": "会反复想很久",
      "posGood": "抗压",
      "negGood": "在意质量"
    },
    "boundary": {
      "name": "无效消耗",
      "pos": "会挡掉",
      "neg": "会接住",
      "posGood": "有边界",
      "negGood": "让人安心"
    }
  },
  "flow": {
    "step1": {
      "prompt": "你最受不了哪几点？",
      "sub": "选 5 个",
      "pick": 5,
      "weight": 1.0
    },
    "step2": {
      "prompt": "剩下的里面，哪几个你完全无感？",
      "sub": "选 3 个",
      "pick": 3,
      "weight": -0.8
    },
    "step3": {
      "prompt": "不上班的时候，你更可能在做什么？",
      "sub": "选 5 个",
      "pick": 5,
      "target": "hobbies",
      "note": "只决定周末内容，不参与原型映射——掺入爱好会破坏五轴的均匀性。"
    },
    "note": "反向选择（完全无感）信息量很高，且体感上仍然是「挑」而不是「答」。",
    "_designFix": "step2 每张 -0.8：5 张正选 vs 3 张无感，负向总量 2.4 对正向 5.0，跟改版前 1.4 : 3.0 的比例一致。无感这一步承担全部反向信号——所有卡都是「戳你的痛苦」，被戳到本身就意味着在意，因此钝感与「什么都接得住」这两类人在原理上无法通过正选表达。"
  },
  "cards": [
    {
      "id": "C01",
      "text": "东西已经能用了，还要再开一次会决定要不要开始",
      "w": {
        "basis": -0.3,
        "tempo": 0.9
      }
    },
    {
      "id": "C02",
      "text": "你三分钟就能试出来的事，被排进了下周的评审",
      "w": {
        "boundary": 0.3,
        "tempo": 0.8
      }
    },
    {
      "id": "C03",
      "text": "你想先把方案想清楚，但对方要你今天就先出个东西",
      "w": {
        "basis": 0.4,
        "tempo": -0.9
      }
    },
    {
      "id": "C04",
      "text": "手上同时挂着五件事，每件都推进了一点点",
      "w": {
        "boundary": 0.3,
        "energy": -0.3,
        "tempo": -0.7
      }
    },
    {
      "id": "C05",
      "text": "一整天没跟任何人说过话，到下班才发现",
      "w": {
        "energy": 0.9,
        "tempo": 0.2
      }
    },
    {
      "id": "C06",
      "text": "远程办公第三天，你开始期待跟外卖员说话",
      "w": {
        "energy": 0.9,
        "tempo": -0.2
      }
    },
    {
      "id": "C07",
      "text": "你刚进入状态，有人在群里 @ 你",
      "w": {
        "boundary": 0.4,
        "energy": -0.9
      }
    },
    {
      "id": "C08",
      "text": "一天排了四个会，中间空的那半小时你什么也没做成",
      "w": {
        "energy": -0.8,
        "tempo": -0.3
      }
    },
    {
      "id": "C09",
      "text": "同步会开完，大家对齐了三种不同的理解",
      "w": {
        "basis": 0.8,
        "boundary": 0.3
      }
    },
    {
      "id": "C10",
      "text": "对方说「再高级一点」，但没说高级在哪",
      "w": {
        "basis": 0.7,
        "resilience": -0.4
      }
    },
    {
      "id": "C11",
      "text": "你有个感觉这样不对，但要你说出理由时你说不出来",
      "w": {
        "basis": -0.9,
        "resilience": -0.3
      }
    },
    {
      "id": "C12",
      "text": "你凭感觉判断对了，对方只说「这次运气好」",
      "w": {
        "basis": -0.8,
        "resilience": -0.2
      }
    },
    {
      "id": "C13",
      "text": "散会有人来问你「刚才没事吧」，你想了半天没想起来是哪件事",
      "w": {
        "energy": -0.2,
        "resilience": 0.9
      }
    },
    {
      "id": "C14",
      "text": "你说没事。对方说「你肯定有事」",
      "w": {
        "boundary": 0.3,
        "resilience": 0.8
      }
    },
    {
      "id": "C15",
      "text": "改到第十一版，最后用的是第一版",
      "w": {
        "basis": -0.2,
        "resilience": -0.9
      }
    },
    {
      "id": "C16",
      "text": "你写的文档没人看，但会上被问的全是文档里写过的",
      "w": {
        "basis": 0.3,
        "energy": -0.3,
        "resilience": -0.6
      }
    },
    {
      "id": "C17",
      "text": "临时被拉进一个不知道为什么需要你在的会",
      "w": {
        "boundary": 0.8,
        "energy": -0.5
      }
    },
    {
      "id": "C18",
      "text": "你说了不行。气氛安静了四秒",
      "w": {
        "boundary": 0.7,
        "resilience": -0.4
      }
    },
    {
      "id": "C19",
      "text": "你答应了三件事，现在没有一件做得完",
      "w": {
        "boundary": -0.9,
        "energy": 0.2,
        "tempo": 0.3
      }
    },
    {
      "id": "C20",
      "text": "明明你手上的事最多，领导还是让你去临时救火",
      "w": {
        "boundary": -0.8,
        "resilience": 0.2
      }
    }
  ],
  "_cardCoverageNote": "20 张卡 = 五轴 × 两端 × 每端 2 张。每一端都有一张主打卡（该轴权重最高）和一张副卡，任何一端都不再只能靠反面推出来。",
  "_hobbyNote": "OOBE 第三步。爱好不是装饰——它决定周末那两天生物在做什么。没有它，周末只能显示通用内容，而周末占了用户全部时间的 2/7。",
